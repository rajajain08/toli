# Firebase web config for toli-app-dev. The web API key is public by design (App Check + rules protect
# the backend). Never put toli-prod values in this file, and never point local code at toli-prod.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA2XetanjTy21ICrky8ILO01lJ18sbfTD8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=toli-app-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=toli-app-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:319596181148:web:de29d2c6283055e5145f59
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 1 = talk to the Emulator Suite (pnpm emulators). 0 = talk to toli-app-dev.
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# App Check (reCAPTCHA Enterprise). Leave empty on the emulators.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
