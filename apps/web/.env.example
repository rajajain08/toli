# Firebase web config for toli-dev (public, but keep prod out of this file). Never point local code at toli-prod.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=toli-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=toli-dev
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Set to 1 to talk to the Emulator Suite (pnpm emulators).
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
