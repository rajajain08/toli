{
  "name": "@toli/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "size": "size-limit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@toli/application": "workspace:*",
    "@toli/catalog": "workspace:*",
    "@toli/domain": "workspace:*",
    "@toli/infra-client": "workspace:*",
    "@toli/ui": "workspace:*",
    "firebase": "^12.19.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "size-limit": "^14.0.0",
    "typescript": "^5.9.3"
  },
  "size-limit": [
    {
      "name": "initial JS for /groups (app shell)",
      "path": [
        ".next/static/chunks/[0-9]*.js",
        ".next/static/chunks/main-app-*.js",
        ".next/static/chunks/webpack-*.js",
        ".next/static/chunks/app/layout-*.js",
        ".next/static/chunks/app/groups/*.js"
      ],
      "limit": "180 KB",
      "gzip": true
    }
  ]
}
