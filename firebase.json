{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "apps/functions/deploy",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["pnpm --filter @toli/functions build"],
      "ignore": ["node_modules", ".git", "*.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "apphosting": [
    {
      "backendId": "toli-web",
      "rootDir": "apps/web",
      "ignore": ["node_modules", ".git", ".next", "**/*.log", "test-results", "playwright-report"]
    }
  ]
}
