{
  "name": "toli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-toli \"vitest run --config tests/rules/vitest.config.ts\"",
    "test:functions": "pnpm --filter @toli/functions build && firebase emulators:exec --only auth,firestore,functions --project demo-toli \"vitest run --config tests/functions/vitest.config.ts\"",
    "test:e2e": "pnpm --filter @toli/functions build && firebase emulators:exec --only auth,firestore,functions --project demo-toli \"playwright test -c tests/e2e/playwright.config.ts\"",
    "emulators": "firebase emulators:start --project demo-toli --import=./tests/seed --export-on-exit",
    "catalog:sync": "pnpm --filter @toli/functions catalog:sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:lighthouse": "lhci autorun --config apps/web/lighthouserc.json",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules && pnpm test:functions && pnpm test:e2e",
    "marketing:export": "pnpm --filter @toli/functions marketing:export"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@toli/application": "workspace:*",
    "@toli/domain": "workspace:*",
    "@toli/infra-admin": "workspace:*",
    "@toli/infra-client": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.1",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@firebase/util",
      "protobufjs",
      "re2",
      "unrs-resolver"
    ]
  }
}
